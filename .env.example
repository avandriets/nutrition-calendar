# Development defaults for compose.yaml. Change all passwords outside local use.
MARIADB_DATABASE=nutrition
MARIADB_USER=nutrition
MARIADB_PASSWORD=nutrition-dev-password
MARIADB_ROOT_PASSWORD=root-dev-password
APP_PORT=8000
APP_WORKERS=2
DB_POOL_RECYCLE_SECONDS=1800

# For an external server, set DATABASE_URL in its environment instead:
# DATABASE_URL=mysql+pymysql://user:url-encoded-password@host:3306/nutrition?charset=utf8mb4
